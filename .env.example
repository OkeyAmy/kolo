# Copy to apps/web/.env.local for local development.
# Kolo holds no keys. There is no wallet, no signer and no private key anywhere
# in this file, because the app never sends a transaction — the user's wallet
# does. If you ever find yourself adding a key here, something has gone wrong.

# Postgres (Neon). Optional locally: without it Kolo runs on an in-memory store,
# which is fine for development and resets on restart.
DATABASE_URL=

# Signs session cookies. Required in production; generated per process in dev.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Read-only Nimiq Albatross RPC, one per chain. Kolo serves both at once: a
# circle is pinned to whichever chain its creator's wallet was on, detected from
# the block height the wallet reports.
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
NIMIQ_TESTNET_RPC_URL=https://rpc.testnet.nimiqwatch.com

# Chain assumed when we cannot tell (outside Nimiq Pay): main | test
NIMIQ_NETWORK=main
